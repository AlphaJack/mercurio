# /etc/mercurio/mercurio.env: every setting of mercurio.service. All variables are listed by `mercurio serve --help` and on the book's "HTTP server" page.

# State lives in /var/lib/mercurio, the unit's only writable directory.
APPRISE_CONFIG_DIR=/var/lib/mercurio/config
APPRISE_STORAGE_DIR=/var/lib/mercurio/cache

# Salt of the hashed configuration file names: set your own random value.
#SECRET_KEY=change-me

# Require Basic Auth with an administrator login.
#APPRISE_AUTH_REQUIRED=yes
#APPRISE_USER=admin
#APPRISE_PASSWORD=change-me

# Hide stored configuration content from everyone but the administrator.
#APPRISE_CONFIG_LOCK=yes

# URLs used by POST /notify when a request gives none.
#APPRISE_STATELESS_URLS=ntfys://ntfy.sh/my-topic

#LOG_LEVEL=INFO

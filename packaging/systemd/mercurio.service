[Unit]
Description=mercurio notification server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A bare name: systemd finds it in /usr/local/bin (manual install) or /usr/bin (packages).
ExecStart=mercurio serve --bind 127.0.0.1:8000
EnvironmentFile=/etc/mercurio/mercurio.env
Restart=on-failure
RestartSec=2

DynamicUser=yes
StateDirectory=mercurio
WorkingDirectory=/var/lib/mercurio
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target

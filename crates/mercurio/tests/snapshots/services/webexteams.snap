        Content-Type: application/json
      method: POST
      url: "https://webexapis.com/v1/messages"
  valid: true
bot_attach:
  ok: true
  requests:
    - body:
        multipart:
          - name: roomId
            value: Y2lzY29zcGFyazovL3VzL1JPT00vabc
          - name: markdown
            value: "Mercurio Title\r\nMercurio Body"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: files
      headers:
        Authorization: Bearer BotToken1234567890
        Content-Type: multipart/form-data
      method: POST
      url: "https://webexapis.com/v1/messages"
    - body:
        multipart:
          - name: roomId
            value: Y2lzY29zcGFyazovL3VzL1JPT00vabc
          - b64: aGVsbG8=
            content_type: text/plain
            filename: notes.txt
            name: files
      headers:
        Authorization: Bearer BotToken1234567890
        Content-Type: multipart/form-data
      method: POST
      url: "https://webexapis.com/v1/messages"
  valid: true

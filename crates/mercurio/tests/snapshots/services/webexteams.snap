blank:
  error: "Cisco Webex Teams: the Webex Teams webhook token specified is invalid"
  valid: false
bot:
  ok: true
  requests:
    - body:
        json:
          markdown: "Mercurio Title\r\nMercurio Body"
          roomId: Y2lzY29zcGFyazovL3VzL1JPT00vabc
      headers:
        Authorization: Bearer BotToken1234567890
        Content-Type: application/json
      method: POST
      url: "https://webexapis.com/v1/messages"
  valid: true

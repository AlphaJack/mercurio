---
source: crates/mercurio/tests/it/services.rs
---
attachment_after_login:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body: ~
          headers:
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: GET
          url: "https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=user.bsky.social"
        - body: ~
          headers:
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: GET
          url: "https://plc.directory/did:plc:1234"
        - body:
            json:
              identifier: "did:plc:1234"
              password: app-pw
          headers:
            Content-Type: application/json
          method: POST
          url: "https://example.pds.io/xrpc/com.atproto.server.createSession"
        - body:
            bytes: iVBORw0KGgo=
          headers:
            Authorization: Bearer abcd
            Content-Type: image/png
          method: POST
          url: "https://example.pds.io/xrpc/com.atproto.repo.uploadBlob"
        - body:
            json:
              collection: app.bsky.feed.post
              record:
                $type: app.bsky.feed.post
                createdAt: ~
                embed:
                  $type: app.bsky.embed.images
                  images:
                    - alt: a.png
                      image:
                        ref: 1
                text: "Mercurio Title\r\nMercurio Body"
              repo: "did:plc:1234"
          headers:
            Authorization: Bearer abcd
            Content-Type: application/json
          method: POST
          url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
    - attempts: 1
      ok: true
      requests:
        - body:
            bytes: iVBORw0KGgo=
          headers:
            Authorization: Bearer abcd
            Content-Type: image/png
          method: POST
          url: "https://example.pds.io/xrpc/com.atproto.repo.uploadBlob"
        - body:
            json:
              collection: app.bsky.feed.post
              record:
                $type: app.bsky.feed.post
                createdAt: ~
                embed:
                  $type: app.bsky.embed.images
                  images:
                    - alt: a.png
                      image:
                        ref: 2
                text: "Mercurio Title\r\nMercurio Body"
              repo: "did:plc:1234"
          headers:
            Authorization: Bearer abcd
            Content-Type: application/json
          method: POST
          url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
  url_id: "88258130"
  valid: true

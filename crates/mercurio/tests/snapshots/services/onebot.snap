attach_fail_skips_target:
  errors:
    - "HTTP 500: {}"
  ok: false
  requests:
    - body:
        json:
          message:
            - data:
                text: "Mercurio Title\r\nMercurio Body"
              type: text
          user_id: 1
      headers:
        Content-Type: application/json
      method: POST
      url: "http://localhost/send_private_msg"
    - body:
        json:
          group_id: 2
          message:
            - data:
                text: "Mercurio Title\r\nMercurio Body"
              type: text
      headers:
        Content-Type: application/json
      method: POST
      url: "http://localhost/send_group_msg"

---
source: crates/mercurio/tests/it/services.rs
---
auth_fail:
  errors:
    - "service error: XMPP authentication failed: not-authorized"
  ok: false
  valid: true
basic_self:
  events:
    - connect:
        direct_tls: false
        host: example.com
        plaintext: true
        port: 5222
        starttls: false
        verify: ~
    - presence: true
    - message:
        body: "Mercurio Title\r\nMercurio Body"
        subject: ""
        to: user@example.com
        type: chat
    - disconnect: true
  ok: true
  valid: true
connect_fail:
  errors:
    - "transport error: no scripted connection for example.com:5222"
  ok: false
  valid: true
escaping:
  events:
    - connect:
        direct_tls: false
        host: example.com
        plaintext: true
        port: 5222
        starttls: false
        verify: ~
    - presence: true
    - message:
        body: "<b>&'\"</b>"
        subject: ""
        to: friend@example.com
        type: chat
    - disconnect: true
  ok: true
  valid: true
insecure_mode_starttls:

auth:
  ok: true
  requests:
    - body:
        json:
          id: 1
          jsonrpc: "2.0"
          method: GUI.ShowNotification
          params:
            displaytime: 12000
            image: "https://example.org/info-128x128.png"
            message: Mercurio Body
            title: Mercurio Title
          type: info
      headers:
        Authorization: Basic dXNlcjpwYXNz
        Content-Type: application/json
      method: POST
      url: "http://localhost/jsonrpc"
  valid: true

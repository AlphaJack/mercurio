---
source: crates/mercurio/tests/it/services.rs
---
api_fail:
  errors:
    - "service error: Notifyre reported failure: \"server error\""
  ok: false
  requests:
    - body:
        json:
          body: "Mercurio Title\r\nMercurio Body"
          campaignName: Mercurio
          from: ""
          recipients:
            - type: mobile_number
              value: "+15551232000"
      headers:
        Content-Type: application/json
        x-api-token: apikey
      method: POST
      url: "https://api.notifyre.com/20220711/sms/send"
  valid: true

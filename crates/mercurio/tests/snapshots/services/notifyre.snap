            - base64Str: TWVyY3VyaW8gVGl0bGUNCk1lcmN1cmlvIEJvZHk=
              contentType: text/plain
          header: Hdr
          isHighQuality: false
          recipients:
            - type: fax_number
              value: "+15551232000"
          scheduledDate: ~
          sendFrom: "+15551239999"
          subject: "Mercurio Title\r\nMercurio Body"
          templateName: Tpl
      headers:
        Content-Type: application/json
        x-api-token: apikey
      method: POST
      url: "https://api.notifyre.com/20220711/fax/send"
  valid: true

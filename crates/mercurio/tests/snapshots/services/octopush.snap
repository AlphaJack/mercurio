---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        json:
          purpose: alert
          recipients:
            - phone_number: "+0987654321"
          sender: Mercurio
          text: "t\r\nb"
          type: sms_premium
          with_replies: false
      headers:
        Accept: application/json
        Content-Type: application/json; charset=utf-8
        api-key: apikey
        api-login: user@myaccount.com
        cache-control: no-cache
      method: POST
      url: "https://api.octopush.com/v1/public/sms-campaign/send"
  valid: true

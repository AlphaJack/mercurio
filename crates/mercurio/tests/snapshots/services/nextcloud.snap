source: crates/mercurio/tests/it/services.rs
---
all_connection_error:
  errors:
    - "group lookup: transport error: scripted connection error"
  ok: false
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Basic dXNlcjpwYXNz
        OCS-APIREQUEST: "true"
      method: GET
      url: "http://localhost/ocs/v1.php/cloud/users?format=json"
  valid: true
all_users:
  ok: true
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Basic dXNlcjpwYXNz
        OCS-APIREQUEST: "true"
      method: GET
      url: "http://localhost/ocs/v1.php/cloud/users?format=json"

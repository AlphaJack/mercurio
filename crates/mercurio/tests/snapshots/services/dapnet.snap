---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        json:
          callSignNames:
            - DF1ABC
          emergency: false
          text: "Mercurio Title\r\nMercurio Body"
          transmitterGroupNames:
            - dl-all
      headers:
        Authorization: Basic dXNlcjpwYXNz
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "http://www.hampager.de:8080/calls"
  valid: true

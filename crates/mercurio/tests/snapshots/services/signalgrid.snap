---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        form:
          - - client_key
            - CLIENTKEY
          - - channel
            - CHANNEL
          - - title
            - Mercurio Title
          - - body
            - Mercurio Body
          - - type
            - INFO
          - - critical
            - "false"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://api.signalgrid.co/v1/push"
  valid: true

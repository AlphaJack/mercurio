mms:
  ok: true
  requests:
    - body:
        multipart:
          - name: username
            value: user
          - name: password
            value: pass
          - name: text
            value: "Mercurio Title\r\nMercurio Body"
          - name: sender
            value: Sender
          - name: phone
            value: "+48500600700"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: file
          - b64: /9j/4AA=
            content_type: image/jpeg
            filename: b.jpg
            name: file
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api2.serwersms.pl/messages/send_mms"
  valid: true
mms_fail:

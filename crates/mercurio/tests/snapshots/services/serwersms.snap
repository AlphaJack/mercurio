api_error:
  errors:
    - "service error: SerwerSMS error: {\"code\":1,\"message\":\"bad\"}"
  ok: false
  requests:
    - body:
        json:
          password: pass
          phone: "+48500600700"
          sender: Sender
          text: "Mercurio Title\r\nMercurio Body"
          username: user
      headers:
        Content-Type: application/json
      method: POST
      url: "https://api2.serwersms.pl/messages/send_sms"
  valid: true

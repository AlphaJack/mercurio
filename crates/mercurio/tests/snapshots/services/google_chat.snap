---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
blank:
  error: "Google Chat: an invalid Google Chat Workspace was specified"
  valid: false
conn_error:
  errors:
    - "transport error: scripted connection error"
  ok: false
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
empty:
  error: "Google Chat: an invalid Google Chat Workspace was specified"
  valid: false
http_201_fails:
  errors:
    - "HTTP 201: {}"
  ok: false
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
http_204_ok:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
http_500:
  errors:
    - "HTTP 500: {}"
  ok: false
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
native:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/myworkspace/messages?token=mytoken&key=mykey"
  valid: true
native_no_params:
  error: "unsupported URL scheme: https://"
  valid: false
native_thread:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
          thread:
            thread_key: mythreadkey
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/myworkspace/messages?token=mytoken&key=mykey&messageReplyOption=REPLY_MESSAGE_FALLBACK_TO_NEW_THREAD"
  valid: true
no_title:
  ok: true
  requests:
    - body:
        json:
          text: World
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
no_token:
  error: "Google Chat: an invalid Google Chat Webhook Token was specified"
  valid: false
params:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/ws/messages?token=mytoken&key=mykey"
  valid: true
params_empty_key:
  error: "Google Chat: an invalid Google Chat Webhook Key was specified"
  valid: false
params_override:
  ok: true
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/ws/messages?token=mytoken&key=my%2Bkey"
  valid: true
pipeline_html:
  ok: true
  requests:
    - body:
        json:
          text: "*Mercurio Title*\n\n*Release*\n\nHello *bold* &amp; _it_ u <http://example.com|link>\n\n- one\n- two\n\n```\nx  y\nz\n```\n\nend"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true
pipeline_markdown:
  ok: true
  requests:
    - body:
        json:
          text: "*Mercurio Title*\n\n*Release notes*\n\nThis has *bold*, _italic_, `code` and a <http://example.com/a_b|link>.\n\n- first item\n- second _item_\n\n> quoted * text &amp; more &lt;stuff&gt;\n\n~gone~ :smile:"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://chat.googleapis.com/v1/spaces/workspace/messages?token=token&key=key"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
basic_avatar:
  ok: true
  requests:
    - body:
        form:
          - - username
            - user
          - - password
            - pass
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "http://localhost/api/v1/login"
    - body:
        json:
          avatar: "https://example.org/failure-128x128.png"
          channel: "#channel1"
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json
        X-Auth-Token: abcd
        X-User-Id: user
      method: POST
      url: "http://localhost/api/v1/chat.postMessage"
    - body:
        json:
          avatar: "https://example.org/failure-128x128.png"
          channel: "#channel2"
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json
        X-Auth-Token: abcd
        X-User-Id: user
      method: POST
      url: "http://localhost/api/v1/chat.postMessage"
    - body: ~
      headers:
        X-Auth-Token: abcd
        X-User-Id: user
      method: POST
      url: "http://localhost/api/v1/logout"
  valid: true

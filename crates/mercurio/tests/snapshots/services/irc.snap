---
source: crates/mercurio/tests/it/services.rs
---
bad_password:
  errors:
    - "service error: Password incorrect: Password incorrect"
  events:
    - connect:
        host: irc.example.com
        port: 6667
        tls: false
    - send: PASS bad
    - send: NICK me
    - send: "USER me 0 * :Mercurio Notifications"
  ok: false
  valid: true
banned:
  errors:
    - "service error: Banned from server: You are banned"
  events:
    - connect:
        host: irc.example.com
        port: 6667
        tls: false
    - send: NICK me
    - send: "USER me 0 * :Mercurio Notifications"
  ok: false
  valid: true
bare_user_target:
  events:
    - connect:
        host: irc.example.com
        port: 6667
        tls: false
    - send: NICK me
    - send: "USER me 0 * :Mercurio Notifications"
    - send: "PRIVMSG bob :Mercurio Title"
    - send: "PRIVMSG bob :Mercurio Body"
    - send: "QUIT :Mercurio Notifications"
  ok: true
  valid: true
basic:
  events:
    - connect:
        host: irc.example.com
        port: 6667
        tls: false
    - send: NICK me
    - send: "USER me 0 * :Mercurio Notifications"
    - send: "JOIN #chan"
    - send: "PRIVMSG #chan :Mercurio Title"
    - send: "PRIVMSG #chan :Mercurio Body"
    - send: "QUIT :Mercurio Notifications"

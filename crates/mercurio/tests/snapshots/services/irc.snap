libera_template:
  events:
    - connect:
        host: irc.libera.chat
        port: 6697
        tls: true
    - send: NICK me
    - send: "USER me 0 * :Mercurio Notifications"
    - send: "PRIVMSG NickServ :IDENTIFY pw"
    - send: "JOIN #chan"
    - send: "PRIVMSG #chan :Mercurio Title"
    - send: "PRIVMSG #chan :Mercurio Body"
    - send: "QUIT :Mercurio Notifications"

---
source: crates/mercurio/tests/it/services.rs
---
badge:
  ok: true
  requests:
    - body:
        json:
          data:
            message: Mercurio Body
          notification:
            badge: 100
            body: Mercurio Body
            title: Mercurio Title
          to: device
      headers:
        Accepts: application/json
        Content-Type: application/json
      method: POST
      url: "https://api.pushy.me/push?api_key=apikey"
  valid: true

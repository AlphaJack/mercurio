accesstoken_param:
  ok: true
  requests:
    - body:
        json:
          message: Mercurio Body
          title: Mercurio Title
      headers:
        Authorization: Bearer long.lived.token
        Content-Type: application/json
      method: POST
      url: "http://localhost:8123/api/services/notify/service"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
attach_multi_skip_text:
  ok: true
  requests:
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=user.bsky.social"
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://plc.directory/did:plc:1234"
    - body:
        json:
          identifier: "did:plc:1234"
          password: app-pw
      headers:
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.server.createSession"
    - body:
        bytes: iVBORw0KGgo=
      headers:
        Authorization: Bearer abcd
        Content-Type: image/png
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.uploadBlob"
    - body:
        bytes: /9j/4AAQ
      headers:
        Authorization: Bearer abcd
        Content-Type: image/jpeg
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.uploadBlob"
    - body:
        json:
          collection: app.bsky.feed.post
          record:
            $type: app.bsky.feed.post
            createdAt: ~
            embed:
              $type: app.bsky.embed.images
              images:
                - alt: a.png
                  image:
                    $type: blob
                    mimeType: image/png
                    ref:
                      $link: baf
                    size: 8
            text: "Mercurio Title\r\nMercurio Body"
          repo: "did:plc:1234"
      headers:
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
    - body:
        json:
          collection: app.bsky.feed.post
          record:
            $type: app.bsky.feed.post
            createdAt: ~
            embed:
              $type: app.bsky.embed.images
              images:
                - alt: b.jpg
                  image:
                    $type: blob
                    mimeType: image/png
                    ref:
                      $link: baf
                    size: 8
            text: 02/02
          repo: "did:plc:1234"
      headers:
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
  valid: true

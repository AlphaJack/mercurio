session_no_token:
  ok: true
  requests:
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=user.bsky.social"
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://plc.directory/did:plc:1234"
    - body:
        json:
          identifier: "did:plc:1234"
          password: app-pw
      headers:
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.server.createSession"
    - body:
        json:
          collection: app.bsky.feed.post
          record:
            $type: app.bsky.feed.post
            createdAt: ~
            text: "Mercurio Title\r\nMercurio Body"
          repo: "did:plc:1234"
      headers:
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
  valid: true
user_password_host:
  ok: true
  requests:
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=user.bsky.social"
    - body: ~
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: GET
      url: "https://plc.directory/did:plc:1234"
    - body:
        json:
          identifier: "did:plc:1234"
          password: secret
      headers:
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.server.createSession"
    - body:
        json:
          collection: app.bsky.feed.post
          record:
            $type: app.bsky.feed.post
            createdAt: ~
            text: "Mercurio Title\r\nMercurio Body"
          repo: "did:plc:1234"
      headers:
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://example.pds.io/xrpc/com.atproto.repo.createRecord"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
batch:
  ok: true
  requests:
    - body:
        form:
          - - countrycode
            - us
          - - message
            - "Mercurio Title\r\nMercurio Body"
          - - from
            - "55555555555"
          - - to
            - "66666666666,77777777777"
      headers:
        Accept: application/json
        Authorization: Basic YWFhYWFhYWE6YmJiYmJiYmJiYmJiYmJiYg==
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://api.transmitsms.com/send-sms.json"
  valid: true

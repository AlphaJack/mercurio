---
source: crates/mercurio/tests/it/services.rs
---
attach:
  ok: true
  requests:
    - body:
        json:
          method: sms.send_sms
          params:
            access_token: token
            attachments:
              - content: iVBORw0KGgo=
                content_type: image/png
            flash: 0
            highpriority: 0
            message: "Mercurio Title\r\nMercurio Body"
            message_type: mms
            responsetype: extended
            test: 0
            to: "123456789"
            unicode: 1
      headers:
        Content-Type: application/json
      method: POST
      url: "http://localhost/jsonrpc/sms"
  valid: true

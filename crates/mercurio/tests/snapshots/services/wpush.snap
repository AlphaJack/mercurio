api_error:
  errors:
    - "service error: WPUSH code=401: API Key error"
  ok: false
  requests:
    - body:
        json:
          apikey: WPUSHabcdefghijklmnopqrstuvwxyz0
          channel: wechat
          content: Mercurio Body
          title: Mercurio Title
      headers:
        Content-Type: application/json
        X-API-Key: WPUSHabcdefghijklmnopqrstuvwxyz0
        X-Idempotency-Key: "<ignored>"
      method: POST
      url: "https://api.wpush.cn/api/v1/send"
  valid: true

attach_only:
  ok: true
  requests:
    - body:
        bytes: iVBORw0KGgo=
      headers:
        Content-Type: image/png
        X-Access-Token: tok
      method: POST
      url: "https://image.groupme.com/pictures"
    - body:
        json:
          attachments:
            - type: image
              url: "https://i.groupme.com/abc"
          bot_id: botid123
          text: ""
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://api.groupme.com/v3/bots/post"
  valid: true

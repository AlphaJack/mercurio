---
source: crates/mercurio/tests/it/services.rs
---
accepted_202:
  ok: true
  requests:
    - body:
        json:
          bot_id: botid123
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://api.groupme.com/v3/bots/post"
  valid: true
attach_bad_json:
  errors:
    - "upload: service error: GroupMe image service returned no URL for a.png"
  ok: false
  requests:
    - body:
        bytes: iVBORw0KGgo=
      headers:
        Content-Type: image/png
        X-Access-Token: tok
      method: POST
      url: "https://image.groupme.com/pictures"
  valid: true

    - body:
        bytes: iVBORw0KGgo=
      headers:
        Content-Type: image/png
        X-Access-Token: tok
      method: POST
      url: "https://image.groupme.com/pictures"
    - body:
        bytes: iVBORw0KGgo=
      headers:
        Content-Type: image/gif
        X-Access-Token: tok
      method: POST
      url: "https://image.groupme.com/pictures"
    - body:
        json:
          attachments:
            - type: image
              url: "https://i.groupme.com/1"
            - type: image
              url: "https://i.groupme.com/2"
          bot_id: botid123

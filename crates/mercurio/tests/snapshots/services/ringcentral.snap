---
source: crates/mercurio/tests/it/services.rs
---
bad_client_id:
  error: "RingCentral: an invalid RingCentral Client ID was specified"
  valid: false
bad_secret:
  error: "RingCentral: an invalid RingCentral Client Secret was specified"
  valid: false
bad_source:
  error: "RingCentral: the RingCentral source (From) phone # is invalid"
  valid: false
basic:
  ok: true
  requests:
    - body:
        form:
          - - grant_type
            - password
          - - username
            - "+15551232000"
          - - password
            - password
          - - access_token_ttl
            - "3600"
          - - refresh_token_ttl
            - "604800"
      headers:
        Accept: application/json
        Authorization: Basic Y2xpZW50aWQ6c2VjcmV0
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://platform.ringcentral.com/restapi/oauth/token"
    - body:
        json:
          from:
            phoneNumber: "+15551232000"
          text: "Mercurio Title\r\nMercurio Body"
          to:
            - phoneNumber: "+15551232000"
      headers:
        Accept: application/json
        Authorization: Bearer abc
        Content-Type: application/json
      method: POST
      url: "https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/sms"
    - body:
        form:
          - - token
            - abc
      headers:
        Accept: application/json
        Authorization: Basic Y2xpZW50aWQ6c2VjcmV0
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://platform.ringcentral.com/restapi/oauth/revoke"
  valid: true
basic_login_fail:
  errors:
    - "login: service error: RingCentral login returned no access token"
  ok: false
  requests:
    - body:
        form:
          - - grant_type
            - password
          - - username
            - "+15551232000"
          - - password
            - password
          - - access_token_ttl
            - "3600"
          - - refresh_token_ttl

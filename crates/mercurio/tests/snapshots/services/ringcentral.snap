mms:
  ok: true
  requests:
    - body:
        form:
          - - grant_type
            - password
          - - username
            - "+15551232000"
          - - password
            - password
          - - access_token_ttl
            - "3600"
          - - refresh_token_ttl
            - "604800"
      headers:
        Accept: application/json
        Authorization: Basic Y2xpZW50aWQ6c2VjcmV0
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://platform.ringcentral.com/restapi/oauth/token"
    - body:
        multipart:
          - content_type: application/json
            name: json
            value: "{\"from\":{\"phoneNumber\":\"+15551232000\"},\"text\":\"Mercurio Title\\r\\nMercurio Body\",\"to\":[{\"phoneNumber\":\"+15551232001\"}]}"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: attachment
      headers:
        Accept: application/json
        Authorization: Bearer abc
        Content-Type: multipart/form-data
      method: POST
      url: "https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/mms"
    - body:
        form:
          - - token
            - abc
      headers:
        Accept: application/json
        Authorization: Basic Y2xpZW50aWQ6c2VjcmV0
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://platform.ringcentral.com/restapi/oauth/revoke"
  valid: true

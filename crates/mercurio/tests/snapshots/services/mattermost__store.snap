---
source: crates/mercurio/tests/it/services.rs
---
failed_lookup_not_cached:
  sends:
    - attempts: 1
      errors:
        - "channel lookup: HTTP 404: {}"
      ok: false
      requests:
        - body: ~
          headers:
            Accept: application/json
            Authorization: Bearer token
          method: GET
          url: "http://localhost/api/v4/teams/name/my%20team/channels/name/chan"
    - attempts: 1
      ok: true
      requests:
        - body: ~
          headers:
            Accept: application/json
            Authorization: Bearer token
          method: GET
          url: "http://localhost/api/v4/teams/name/my%20team/channels/name/chan"
        - body:
            json:
              channel_id: r2
              message: "Mercurio Title\r\nMercurio Body"
          headers:
            Authorization: Bearer token
            Content-Type: application/json
          method: POST
          url: "http://localhost/api/v4/posts"
  url_id: 2d2492d8
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
login_fails_then_works:
  sends:
    - attempts: 1
      errors:
        - "token: HTTP 500: {}"
      ok: false
      requests:
        - body:
            json:
              client_id: client_id
              client_secret: cs1
              grant_type: client_credentials
          headers:
            Content-Type: application/json
          method: POST
          url: "https://api.sendpulse.com/oauth/access_token"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              client_id: client_id
              client_secret: cs1
              grant_type: client_credentials
          headers:
            Content-Type: application/json
          method: POST
          url: "https://api.sendpulse.com/oauth/access_token"
        - body:
            json:
              email:
                from:
                  email: user@example.com
                  name: Mercurio
                html: TWVyY3VyaW8gQm9keQ==
                subject: Mercurio Title
                text: Mercurio Body
                to:
                  - email: user@example.com
                    name: Mercurio
          headers:
            Authorization: Bearer t2
            Content-Type: application/json
          method: POST
          url: "https://api.sendpulse.com/smtp/emails"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              email:
                from:
                  email: user@example.com
                  name: Mercurio
                html: TWVyY3VyaW8gQm9keQ==
                subject: Mercurio Title
                text: Mercurio Body
                to:
                  - email: user@example.com
                    name: Mercurio
          headers:
            Authorization: Bearer t2
            Content-Type: application/json
          method: POST
          url: "https://api.sendpulse.com/smtp/emails"
  url_id: bca5d3e0
  valid: true

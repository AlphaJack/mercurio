batch_no:
  ok: true
  requests:
    - body:
        json:
          messages:
            - body: "Mercurio Title\r\nMercurio Body"
              source: php
              to: "+33333333333333"
      headers:
        Authorization: Basic dXNlcjpwYXNz
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://rest.clicksend.com/v3/sms/send"
  valid: true

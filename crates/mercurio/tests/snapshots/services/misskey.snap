basic:
  ok: true
  requests:
    - body:
        json:
          i: access_token
          text: "Mercurio Title\r\nMercurio Body"
          visibility: public
      headers:
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/notes/create"
  valid: true

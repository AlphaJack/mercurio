api_error_msg:
  errors:
    - "service error: WxPusher code=Some(1002): bad token"
  ok: false
  requests:
    - body:
        json:
          appToken: AT_appid
          content: Mercurio Body
          contentType: 1
          summary: Mercurio Title
          topicIds:
            - 123
          uids: []
          url: ~
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://wxpusher.zjiecode.com/api/send/message"
  valid: true

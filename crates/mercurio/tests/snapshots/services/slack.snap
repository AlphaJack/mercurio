---
source: crates/mercurio/tests/it/services.rs
---
blank:
  error: "Slack: an invalid Slack (first) Token was specified"
  valid: false
bot_attach:
  ok: true
  requests:
    - body:
        json:
          attachments:
            - color: "#3AA3E3"
              footer: Mercurio
              footer_icon: "https://example.org/info-72x72.png"
              text: Mercurio Body
              title: Mercurio Title
              ts: ~
          channel: "#chan"
          icon_url: "https://example.org/info-72x72.png"
          mrkdwn: true
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://slack.com/api/chat.postMessage"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: application/json; charset=utf-8
      method: GET
      url: "https://slack.com/api/files.getUploadURLExternal?filename=a.png&length=8"
    - body:
        multipart:
          - b64: iVBORw0KGgo=
            filename: a.png
            name: file
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: multipart/form-data
      method: POST
      url: "https://files.slack.test/upload"
    - body:
        json:
          channel_id: C123456
          files:
            - id: F123ABC456
              title: a.png
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://slack.com/api/files.completeUploadExternal"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: application/json; charset=utf-8
      method: GET
      url: "https://slack.com/api/files.getUploadURLExternal?filename=notes.txt&length=5"
    - body:
        multipart:
          - b64: aGVsbG8=
            filename: notes.txt
            name: file
      headers:
        Accept: application/json
        Authorization: Bearer xoxb-1234-1234-abc124
        Content-Type: multipart/form-data
      method: POST
      url: "https://files.slack.test/upload"
    - body:
        json:

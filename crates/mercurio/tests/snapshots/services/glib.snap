---
source: crates/mercurio/tests/it/services.rs
---
basic:
  events:
    - notify:
        - Mercurio
        - 0
        - "<tmp>/mercurio/icon.svg"
        - Mercurio Title
        - Mercurio Body
        - []
        - urgency: 1
        - 13000
  ok: true
  valid: true
fails:
  errors:
    - "service error: gdbus exited with status 1"
  ok: false
  valid: true
failure_type:
  events:
    - notify:
        - Mercurio
        - 0
        - "<tmp>/mercurio/icon.svg"
        - T
        - B
        - []
        - urgency: 1
        - 13000
  ok: true
  valid: true
gio:

basic_markdown_implied:
  ok: true
  requests:
    - body:
        json:
          embeds:
            - colour: "#3AA3E3"
              description: Mercurio Body
              icon_url: "https://example.org/info-256x256.png"
              replies: ~
              title: Mercurio Title
      headers:
        Accept: application/json; charset=utf-8
        Content-Type: application/json; charset=utf-8
        X-Bot-Token: iiiiiiiiiiiiiiiiiiiiiiii
      method: POST
      url: "https://api.revolt.chat/channels/tttttttttttttttttttttttt/messages"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        form:
          - - title
            - Mercurio Title
          - - desp
            - Mercurio Body
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://sctapi.ftqq.com/12345678.send"
  valid: true
bizarre_code:
  errors:
    - "HTTP 999 "
  ok: false

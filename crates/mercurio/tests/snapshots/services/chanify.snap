bad_token:
  error: "Chanify: the Chanify token specified is invalid"
  valid: false
basic:
  ok: true
  requests:
    - body:
        form:
          - - text
            - "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://api.chanify.net/v1/sender/abc123/"
  valid: true

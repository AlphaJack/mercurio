        json:
          body: Mercurio Body
          device_iden: d1
          title: Mercurio Title
          type: note
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE6
        Content-Type: application/json
      method: POST
      url: "https://api.pushbullet.com/v2/pushes"
    - body:
        json:
          file_name: a.png
          file_type: image/png
          file_url: "https://dl.pushbulletusercontent.com/abc/a.png"
          image_url: "https://dl.pushbulletusercontent.com/abc/a.png"
          type: file
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE6
        Content-Type: application/json
      method: POST
      url: "https://api.pushbullet.com/v2/pushes"

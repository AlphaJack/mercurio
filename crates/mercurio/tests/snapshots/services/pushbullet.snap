---
source: crates/mercurio/tests/it/services.rs
---
attach_bad_response:
  errors:
    - "upload request: service error: Pushbullet: unexpected upload-request response"
  ok: false
  requests:
    - body:
        json:
          file_name: a.png
          file_type: image/png
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE6
        Content-Type: application/json
      method: POST
      url: "https://api.pushbullet.com/v2/upload-request"
  valid: true
attach_file_push_fails:
  errors:
    - "push: HTTP 500: {}"
    - "push: HTTP 500: {}"
  ok: false
  requests:
    - body:
        json:
          file_name: a.png
          file_type: image/png
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE6
        Content-Type: application/json
      method: POST
      url: "https://api.pushbullet.com/v2/upload-request"
    - body:
        multipart:
          - b64: iVBORw0KGgo=
            filename: a.png
            name: file
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE6
        Content-Type: multipart/form-data
      method: POST
      url: "https://upload.pushbullet.com/abcd123"

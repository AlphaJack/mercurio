---
source: crates/mercurio/tests/it/services.rs
---
conn_error:
  errors:
    - "transport error: scripted connection error"
  ok: false
  requests:
    - body:
        json:
          data:
            alert: Mercurio Body
            title: Mercurio Title
          where:
            deviceType:
              $in:
                - ios
                - android
      headers:
        Content-Type: application/json
        X-Parse-Application-Id: app_id
        X-Parse-Master-Key: master_key
      method: POST
      url: "https://localhost/parse/push/"
  valid: true

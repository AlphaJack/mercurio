---
source: crates/mercurio/tests/it/services.rs
---
attach_batch:
  ok: true
  requests:
    - body:
        json:
          allow_mentions:
            parse:
              - joe
            roles: []
            users: []
          avatar_url: "https://example.org/info-256x256.png"
          content: 👉 @joe
          embeds:
            - author:
                name: Mercurio
                url: "https://example.org"
              color: 3843043
              description: Mercurio Body
              title: Mercurio Title
          tts: false
          wait: true
      headers:
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://discord.com/api/webhooks/iiiiiiiiiiiiiiiiiiiiiiii/tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
    - body:
        multipart:
          - name: payload_json
            value: "{\"avatar_url\":\"https://example.org/info-256x256.png\",\"tts\":false,\"wait\":true}"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: "files[0]"
          - b64: aGVsbG8=
            content_type: text/plain
            filename: b.txt
            name: "files[1]"
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://discord.com/api/webhooks/iiiiiiiiiiiiiiiiiiiiiiii/tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
  valid: true

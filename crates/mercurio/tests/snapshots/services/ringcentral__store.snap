                - phoneNumber: "+15551232000"
          headers:
            Accept: application/json
            Authorization: Bearer abc
            Content-Type: application/json
          method: POST
          url: "https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/sms"
  url_id: cfa7ef7c
  valid: true

pipeline_text:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Mercurio Title\r\nPlain <text> & *stars* _under_ [x](y)\nsecond line"
          visibility: public
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
pipeline_truncate_markdown:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Mercurio Title\r\n## Section 1\n\nParagraph 1 has **bold 1** and *italic* words, a [link 1](http://example.com/1) and `code 1`. Sentences keep going so splitting has to pick a boundary.\n\n- point 1a\n- point 1b\n\n## Section 2\n\nParagraph 2 has **bold 2** and *italic* words, a [link 2](http://example.com/2) and `code 2`. Sentences keep going so splitting has to pick a boundary.\n\n- point 2a\n- point 2b\n\n## Section 3"
          visibility: public
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
spoiler_lang_key:
  ok: true
  requests:
    - body:
        json:
          Idempotency-Key: My Key
          language: en
          sensitive: true
          spoiler_text: spoiler text
          status: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "https://hostname:8443/api/v1/statuses"
  valid: true

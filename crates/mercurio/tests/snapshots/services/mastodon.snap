---
source: crates/mercurio/tests/it/services.rs
---
attach_batch:
  ok: true
  requests:
    - body:
        multipart:
          - name: description
            value: a.png
          - b64: iVBORw0KGgo=
            content_type: application/octet-stream
            filename: a.png
            name: file
      headers:
        Authorization: Bearer access_token
        Content-Type: multipart/form-data
      method: POST
      url: "http://hostname/api/v1/media"
    - body:
        multipart:
          - name: description
            value: b.png
          - b64: iVBORw0KGgo=
            content_type: application/octet-stream
            filename: b.png
            name: file
      headers:
        Authorization: Bearer access_token
        Content-Type: multipart/form-data
      method: POST
      url: "http://hostname/api/v1/media"
    - body:
        multipart:
          - name: description
            value: c.gif
          - b64: iVBORw0KGgo=
            content_type: application/octet-stream
            filename: c.gif
            name: file
      headers:
        Authorization: Bearer access_token
        Content-Type: multipart/form-data
      method: POST
      url: "http://hostname/api/v1/media"
    - body:
        multipart:
          - name: description
            value: d.png
          - b64: iVBORw0KGgo=
            content_type: application/octet-stream
            filename: d.png
            name: file
      headers:
        Authorization: Bearer access_token
        Content-Type: multipart/form-data
      method: POST
      url: "http://hostname/api/v1/media"
    - body:
        json:
          Idempotency-Key: abc
          media_ids:
            - "1"
            - 2
            - "3"
          sensitive: true
          status: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
    - body:
        json:
          Idempotency-Key: abc-part01
          media_ids:
            - "4"
          sensitive: false
          status: 02/02
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true

    - body:
        json:
          sensitive: false
          status: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
direct_target_email:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "@target Direct body contains email@target only."
          visibility: direct
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
direct_target_in_body:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: Direct body already contains @target.
          visibility: direct
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
direct_whoami:
  ok: true
  requests:
    - body:
        json: ~
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: GET
      url: "http://hostname/api/v1/accounts/verify_credentials"
    - body:
        json:
          sensitive: false
          status: "@test Mercurio Title\r\nMercurio Body"
          visibility: direct
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
direct_whoami_403:
  errors:
    - "account lookup: HTTP 403: {\"error\":\"no authorized scopes\"}"
  ok: false
  requests:
    - body:
        json: ~
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: GET
      url: "http://hostname/api/v1/accounts/verify_credentials"
  valid: true
direct_whoami_fail:
  errors:
    - "account lookup: service error: could not look up the Mastodon account"
  ok: false
  requests:
    - body:
        json: ~
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: GET
      url: "http://hostname/api/v1/accounts/verify_credentials"
  valid: true
hashtag_path_ping:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Body #apprise #media"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
invalid_targets:
  error: "Mastodon: no Mastodon targets to notify"
  valid: false
invalid_visibility:
  error: "Mastodon: the Mastodon visibility specified is invalid"
  valid: false
markdown_heading:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Title\n\nmy_app done @bob@host.org #tag @bob@host.org #tag"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
markdown_pings:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Body #déjà_vu and @abc, plus #再会. Ignore ##bad, #bad%, #123, email@miss, and duplicate @abc #déjà_vu. @abc #déjà_vu #再会 #radarr"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
markdown_title:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Deploy\n\ndone"
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
no_token:
  error: "Mastodon: an invalid Mastodon Access Token was specified"
  valid: false
pipeline_html:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Mercurio Title\r\nRelease\n\nHello bold & it u link\n\n- one\n- two\n\nx  y\nz\n\nend"
          visibility: public
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
pipeline_markdown:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "Mercurio Title\r\n# Release notes\n\nThis has **bold**, *italic*, `code` and a [link](http://example.com/a_b).\n\n- first item\n- second *item*\n\n> quoted \\* text & more <stuff>\n\n~~gone~~ :smile:"
          visibility: public
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
  valid: true
pipeline_split_markdown:
  ok: true
  requests:
    - body:
        json:
          sensitive: false
          status: "A title that is long enough to be interesting for counters and amalgamation A title that is long enough to be interesting for counters and amalgamation\r\n## Section 1\n\nParagraph 1 has **bold 1** and *italic* words, a [link 1](http://example.com/1) and `code 1`. Sentences keep going so splitting has to pick a boundary.\n\n- point 1a\n- point 1b\n\n## Section 2"
          visibility: public
      headers:
        Authorization: Bearer access_token
        Content-Type: application/json
      method: POST
      url: "http://hostname/api/v1/statuses"
    - body:
        json:
          sensitive: false
          status: "Paragraph 2 has **bold 2** and *italic* words, a [link 2](http://example.com/2) and `code 2`. Sentences keep going so splitting has to pick a boundary.\n\n- point 2a\n- point 2b\n\n## Section 3\n\nParagraph 3 has **bold 3** and *italic* words, a [link 3](http://example.com/3) and `code 3`. Sentences keep going so splitting has to pick a boundary.\n\n- point 3a\n- point 3b\n\n## Section 4"

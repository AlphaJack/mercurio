---
source: crates/mercurio/tests/it/services.rs
---
blank_project:
  error: "Firebase Cloud Messaging: the FCM legacy API (server key) was shut down in July 2024: give the project ID and ?keyfile= with a service account JSON key"
  valid: false
color_hex:
  ok: true
  requests:
    - body:
        form:
          - - assertion
            - "<ignored>"
          - - grant_type
            - "urn:ietf:params:oauth:grant-type:jwt-bearer"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://oauth2.googleapis.com/token"
    - body:
        json:
          message:
            android:
              notification:
                color: "#aabbcc"
            notification:
              body: Mercurio Body
              title: Mercurio Title
            token: device
      headers:
        Authorization: Bearer ya29.token
        Content-Type: application/json
      method: POST
      url: "https://fcm.googleapis.com/v1/projects/mercurio-project/messages:send"
  valid: true

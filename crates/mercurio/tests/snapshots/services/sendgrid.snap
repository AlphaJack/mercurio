accepted:
  ok: true
  requests:
    - body:
        json:
          content:
            - type: text/html
              value: Mercurio Body
          from:
            email: user@example.ca
          personalizations:
            - to:
                - email: newuser@example.ca
          subject: Mercurio Title
      headers:
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.sendgrid.com/v3/mail/send"
  valid: true

bad_lang:
  error: "OneSignal: an invalid OneSignal Language was specified"
  valid: false
batch_no:
  ok: true
  requests:
    - body:
        json:
          app_id: appid
          content_available: true
          contents:
            en: Mercurio Body
          headings:
            en: Mercurio Title
          include_player_ids:
            - pid1
          large_icon: "https://example.org/info-72x72.png"
          small_icon: "https://example.org/info-32x32.png"
      headers:
        Authorization: Basic apikey
        Content-Type: application/json; charset=utf-8
      method: POST
      url: "https://api.onesignal.com/notifications"
    - body:
        json:
          app_id: appid
          content_available: true
          contents:
            en: Mercurio Body
          headings:
            en: Mercurio Title
          include_external_user_ids:

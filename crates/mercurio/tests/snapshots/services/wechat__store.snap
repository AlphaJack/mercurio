---
source: crates/mercurio/tests/it/services.rs
---
expired_token_evicted:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body: ~
          headers: {}
          method: GET
          url: "https://qyapi.weixin.qq.com/cgi-bin/gettoken?corpid=corpid&corpsecret=secret"
        - body:
            json:
              agentid: 1000002
              msgtype: text
              text:
                content: "Mercurio Title\r\nMercurio Body"
              touser: johndoe
          headers:
            Content-Type: application/json
          method: POST
          url: "https://qyapi.weixin.qq.com/cgi-bin/message/send?access_token=OLD"
    - attempts: 1
      errors:
        - "send: service error: failed to send WeChat (WeCom) notification: errcode=42001: expired"
      ok: false
      requests:
        - body:
            json:
              agentid: 1000002
              msgtype: text
              text:
                content: "Mercurio Title\r\nMercurio Body"
              touser: johndoe
          headers:
            Content-Type: application/json
          method: POST
          url: "https://qyapi.weixin.qq.com/cgi-bin/message/send?access_token=OLD"
    - attempts: 1
      ok: true
      requests:
        - body: ~
          headers: {}
          method: GET
          url: "https://qyapi.weixin.qq.com/cgi-bin/gettoken?corpid=corpid&corpsecret=secret"
        - body:
            json:
              agentid: 1000002
              msgtype: text
              text:
                content: "Mercurio Title\r\nMercurio Body"
              touser: johndoe
          headers:
            Content-Type: application/json
          method: POST
          url: "https://qyapi.weixin.qq.com/cgi-bin/message/send?access_token=NEW"
  url_id: d42a5005
  valid: true

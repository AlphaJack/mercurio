---
source: crates/mercurio/tests/it/services.rs
---
api_error:
  errors:
    - "service error: Viber error: invalidAuthToken"
  ok: false
  requests:
    - body:
        json:
          receiver: t10
          sender:
            name: Mercurio Notifications
          text: "Mercurio Title\r\nMercurio Body"
          type: text
      headers:
        Content-Type: application/json
        X-Viber-Auth-Token: token
      method: POST
      url: "https://chatapi.viber.com/pa/send_message"
  valid: true

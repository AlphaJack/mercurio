all_qs:
  ok: true
  requests:
    - body:
        json:
          client: Mercurio
          event_action: trigger
          images:
            - alt: info
              src: "https://example.org/info-128x128.png"
          payload:
            component: c
            severity: info
            source: s
            summary: "Mercurio Title\r\nMercurio Body"
          routing_key: r
      headers:
        Authorization: Token token=a
        Content-Type: application/json
      method: POST
      url: "https://events.pagerduty.com/v2/enqueue"
  valid: true
bad_region:
  error: "Pager Duty: the PagerDuty region specified is invalid"
  valid: false
bad_severity:
  error: "Pager Duty: the PagerDuty severity specified is invalid"

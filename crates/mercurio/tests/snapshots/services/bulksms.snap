batch_multi:
  ok: true
  requests:
    - body:
        json:
          body: "Mercurio Title\r\nMercurio Body"
          deliveryReports: ERRORS
          encoding: UNICODE
          routingGroup: STANDARD
          to:
            - "+44444444444"
            - "+55555555555"
      headers:
        Authorization: Basic YmJiYmI6Y2NjY2NjY2NjYw==
        Content-Type: application/json
      method: POST
      url: "https://api.bulksms.com/v1/messages"

---
source: crates/mercurio/tests/it/services.rs
---
bad_host:
  error: "Twist: an invalid hostname or port was specified"
  valid: false
basic_default_channel:
  ok: true
  requests:
    - body:
        form:
          - - email
            - user@example.com
          - - password
            - password
      headers:
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: POST
      url: "https://api.twist.com/api/v3/users/login"
    - body:
        form:
          - - workspace_id
            - "5"
      headers:
        Authorization: Bearer tok123
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: POST
      url: "https://api.twist.com/api/v3/channels/get"
    - body:
        form:
          - - channel_id
            - "999"
          - - title
            - Mercurio Title
          - - content
            - Mercurio Body
      headers:
        Authorization: Bearer tok123
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: POST
      url: "https://api.twist.com/api/v3/threads/add"
    - body: ~
      headers:
        Authorization: Bearer tok123
        Content-Type: application/x-www-form-urlencoded; charset=utf-8
      method: POST
      url: "https://api.twist.com/api/v3/users/logout"
  valid: true

email_lookup_cached:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body: ~
          headers:
            Authorization: Bearer xoxb-1234-1234-abc124
            Content-Type: application/x-www-form-urlencoded
          method: GET
          url: "https://slack.com/api/users.lookupByEmail?email=user%40example.com"
        - body:
            json:
              attachments:
                - color: "#3AA3E3"
                  text: Mercurio Body
                  title: Mercurio Title
              channel: U1
              icon_url: "https://example.org/info-72x72.png"
              mrkdwn: true
          headers:
            Accept: application/json
            Authorization: Bearer xoxb-1234-1234-abc124
            Content-Type: application/json; charset=utf-8
          method: POST
          url: "https://slack.com/api/chat.postMessage"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              attachments:
                - color: "#3AA3E3"
                  text: Mercurio Body
                  title: Mercurio Title
              channel: U1
              icon_url: "https://example.org/info-72x72.png"
              mrkdwn: true
          headers:
            Accept: application/json
            Authorization: Bearer xoxb-1234-1234-abc124
            Content-Type: application/json; charset=utf-8
          method: POST
          url: "https://slack.com/api/chat.postMessage"
  url_id: 8b474911
  valid: true
retry_attachment_reuses_channel_ids:

---
source: crates/mercurio/tests/it/services.rs
---
attachment:
  errors:
    - "HTTP 500: {}"
  ok: false
  requests:
    - body:
        multipart:
          - name: "o:skip-verification"
            value: "False"
          - name: from
            value: Mercurio <user@localhost.localdomain>
          - name: subject
            value: Mercurio Title
          - name: html
            value: Mercurio Body
          - name: to
            value: a@example.com
          - b64: iVBORw0KGgo=
            filename: a.png
            name: "attachment[0]"
          - b64: aGVsbG8=
            filename: b.txt
            name: "attachment[1]"
      headers:
        Accept: application/json
        Authorization: Basic YXBpOmFwaWtleQ==
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.mailgun.net/v3/localhost.localdomain/messages"
    - body:
        multipart:
          - name: "o:skip-verification"
            value: "False"
          - name: from
            value: Mercurio <user@localhost.localdomain>
          - name: subject
            value: Mercurio Title
          - name: html
            value: Mercurio Body
          - name: to
            value: b@example.com
          - b64: iVBORw0KGgo=
            filename: a.png
            name: "attachment[0]"
          - b64: aGVsbG8=
            filename: b.txt
            name: "attachment[1]"
      headers:
        Accept: application/json
        Authorization: Basic YXBpOmFwaWtleQ==
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.mailgun.net/v3/localhost.localdomain/messages"
  valid: true

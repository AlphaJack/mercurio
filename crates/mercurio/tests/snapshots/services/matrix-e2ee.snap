      method: POST
      url: "https://localhost/_matrix/client/v3/register?kind=user"
    - body:
        json:
          device_keys:
            algorithms:
              - m.olm.v1.curve25519-aes-sha2
              - m.megolm.v1.aes-sha2
            device_id: DEVICE1
            keys: ~
            signatures: ~
            user_id: "@apprise:localhost"
          fallback_keys: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/keys/upload"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/join/%21room%3Alocalhost"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/state/m.room.encryption"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/joined_members"
    - body:
        json:
          device_keys:
            "@apprise:localhost": []
            "@bob:localhost": []
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/keys/query"
    - body:
        json:
          one_time_keys:
            "@apprise:localhost": {}
            "@bob:localhost":
              BOBDEV: signed_curve25519
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/keys/claim"
    - body:
        json:
          algorithm: m.megolm.v1.aes-sha2
          ciphertext: ~
          device_id: DEVICE1
          sender_key: ~
          session_id: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/send/m.room.encrypted/0"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/logout"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
autoverify_implies_e2ee:
  ok: true
  requests:
    - body:
        json:
          identifier:
            type: m.id.user
            user: user
          initial_device_display_name: Mercurio
          password: pass
          type: m.login.password
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/login"
    - body:
        json:
          auth:
            type: m.login.dummy
          initial_device_display_name: Mercurio
          kind: user
          password: pass
          username: user
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/register?kind=user"
    - body:
        json:
          device_keys:
            algorithms:
              - m.olm.v1.curve25519-aes-sha2
              - m.megolm.v1.aes-sha2
            device_id: DEVICE1
            keys: ~
            signatures: ~
            user_id: "@apprise:localhost"
          fallback_keys: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/keys/upload"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/sync?timeout=2000&filter=%7B%22presence%22%3A+%7B%22types%22%3A+%5B%5D%7D%2C+%22account_data%22%3A+%7B%22types%22%3A+%5B%5D%7D%2C+%22room%22%3A+%7B%22rooms%22%3A+%5B%5D%7D%7D&set_presence=offline"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/join/%21room%3Alocalhost"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/state/m.room.encryption"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/joined_members"
    - body:
        json:
          algorithm: m.megolm.v1.aes-sha2
          ciphertext: ~
          device_id: DEVICE1
          sender_key: ~
          session_id: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/send/m.room.encrypted/0"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/logout"
  valid: true

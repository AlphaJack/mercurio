    - body:
        json:
          initial_state:
            - content:
                algorithm: m.megolm.v1.aes-sha2
              state_key: ""
              type: m.room.encryption
          name: "#newroom - Mercurio Notifications"
          preset: trusted_private_chat
          room_alias_name: newroom
          visibility: private
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/createRoom"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21new%3Alocalhost/joined_members"
    - body:
        json:
          algorithm: m.megolm.v1.aes-sha2
          ciphertext: ~
          device_id: DEVICE1
          sender_key: ~
          session_id: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "https://localhost/_matrix/client/v3/rooms/%21new%3Alocalhost/send/m.room.encrypted/0"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/logout"
  valid: true
dm_encrypted:
  ok: true
  requests:
    - body: ~
      headers:
        Accept: application/json
      method: GET
      url: "https://localhost/.well-known/matrix/client"
    - body:
        json:
          identifier:
            type: m.id.user
            user: user
          initial_device_display_name: Mercurio
          password: pass
          type: m.login.password
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/login"
    - body:
        json:
          auth:
            type: m.login.dummy
          initial_device_display_name: Mercurio
          kind: user
          password: pass
          username: user
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/register?kind=user"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/user/%40apprise%3Alocalhost/account_data/m.direct"
    - body:
        json:
          initial_state:
            - content:
                algorithm: m.megolm.v1.aes-sha2
              state_key: ""
              type: m.room.encryption
          invite:
            - "@bob:localhost"
          is_direct: true
          preset: trusted_private_chat
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/createRoom"
    - body:
        json:
          "@bob:localhost":
            - "!dm:localhost"
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "https://localhost/_matrix/client/v3/user/%40apprise%3Alocalhost/account_data/m.direct"
    - body:
        json:
          device_keys:
            algorithms:
              - m.olm.v1.curve25519-aes-sha2
              - m.megolm.v1.aes-sha2
            device_id: DEVICE1
            keys: ~
            signatures: ~
            user_id: "@apprise:localhost"
          fallback_keys: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/keys/upload"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/join/%21dm%3Alocalhost"
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
      method: GET
      url: "https://localhost/_matrix/client/v3/rooms/%21dm%3Alocalhost/joined_members"
    - body:
        json:
          algorithm: m.megolm.v1.aes-sha2
          ciphertext: ~
          device_id: DEVICE1
          sender_key: ~
          session_id: ~
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "https://localhost/_matrix/client/v3/rooms/%21dm%3Alocalhost/send/m.room.encrypted/0"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://localhost/_matrix/client/v3/logout"
  valid: true

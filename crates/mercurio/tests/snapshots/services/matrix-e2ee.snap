      method: PUT
      url: "https://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/send/m.room.encrypted/1"
    - body:
        bytes: "<ignored>"
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/octet-stream
      method: POST
      url: "https://localhost/_matrix/media/v3/upload?filename=a.png"

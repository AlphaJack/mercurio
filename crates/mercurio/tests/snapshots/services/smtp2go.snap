  ok: true
  requests:
    - body:
        json:
          api_key: key
          html_body: Mercurio Body
          sender: user@localhost.localdomain
          subject: Mercurio Title
          to:
            - test@example.com
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://api.smtp2go.com/v3/email/send"
  valid: true
quote_user:
  error: "SMTP2Go: invalid ~From~ email format"
  valid: false
server_error:
  errors:
    - "HTTP 500: {}"
  ok: false
  requests:
    - body:
        json:
          api_key: key
          html_body: Mercurio Body
          sender: user@localhost.localdomain
          subject: Mercurio Title
          to:
            - user@localhost.localdomain
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://api.smtp2go.com/v3/email/send"
  valid: true
text:
  ok: true
  requests:
    - body:
        json:
          api_key: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbb-cccccccc
          sender: user@localhost.localdomain
          subject: ""
          text_body: Mercurio Body
          to:
            - user@localhost.localdomain
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "https://api.smtp2go.com/v3/email/send"
  valid: true
to_param:
  ok: true
  requests:
    - body:
        json:
          api_key: key
          html_body: Mercurio Body
          sender: user@localhost.localdomain
          subject: Mercurio Title
          to:
            - test@example.com
      headers:
        Accept: application/json

---
source: crates/mercurio/tests/it/services.rs
---
attach:
  ok: true
  requests:
    - body:
        json:
          data:
            message: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: Bearer mytoken
        Content-Type: application/json
      method: POST
      url: "https://hostname/api/v1/post/container/1"
    - body:
        multipart:
          - b64: aGVsbG8=
            filename: a.txt
            name: "files[]"
      headers:
        Authorization: Bearer mytoken
        Content-Type: multipart/form-data
      method: POST
      url: "https://hostname/api/v1/post/42/upload-files"
  valid: true
attach_bad_json:
  errors:
    - "service error: failed to parse the HumHub post id; attachments not sent"
  ok: false

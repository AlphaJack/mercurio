---
source: crates/mercurio/tests/it/services.rs
---
bad_sender:
  error: "Mobile Message: the Mobile Message Sender ID specified is invalid"
  valid: false
batch_len_mismatch:
  errors:
    - "service error: Mobile Message returned an unexpected response"
    - "service error: Mobile Message returned an unexpected response"
  ok: false
  requests:
    - body:
        json:
          enable_unicode: false
          max_parts: 10
          messages:
            - message: "Mercurio Title\r\nMercurio Body"
              sender: MyBiz
              to: "61412345678"
            - message: "Mercurio Title\r\nMercurio Body"
              sender: MyBiz
              to: "61412345679"
      headers:
        Accept: application/json
        Authorization: Basic dXNlcjpwYXNz
        Content-Type: application/json
        Idempotency-Key: "<ignored>"
      method: POST
      url: "https://api.mobilemessage.com.au/v1/messages"
  valid: true

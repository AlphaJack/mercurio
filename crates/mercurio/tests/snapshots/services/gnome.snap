---
source: crates/mercurio/tests/it/services.rs
---
basic:
  events:
    - gnome:
        app: Mercurio
        body: "Mercurio Title\r\nMercurio Body"
        icon: /run/user/1000/mercurio/icon.svg
        urgency: 1
  ok: true
  valid: true
fails:
  errors:
    - "service error: D-Bus Notify failed: org.freedesktop.DBus.Error.Failed: scripted failure"
  ok: false
  valid: true
failure_type:
  events:
    - gnome:
        app: Mercurio
        body: "T\r\nB"
        icon: /run/user/1000/mercurio/icon.svg
        urgency: 1
  ok: true
  valid: true

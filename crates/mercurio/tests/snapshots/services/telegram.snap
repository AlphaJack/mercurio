---
source: crates/mercurio/tests/it/services.rs
---
album:
  ok: true
  requests:
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - name: disable_notification
            value: "false"
          - name: media
            value: "[{\"caption\":\"<b>Mercurio Title</b>\\r\\nMercurio Body\",\"media\":\"attach://file0\",\"parse_mode\":\"HTML\",\"show_caption_above_media\":true,\"type\":\"photo\"},{\"media\":\"attach://file1\",\"type\":\"photo\"}]"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: file0
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: b.png
            name: file1
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendMediaGroup"
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - b64: cGRmZGF0YQ==
            filename: doc.pdf
            name: document
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendDocument"
  valid: true
album_retry:
  ok: true
  requests:
    - body:
        json:
          chat_id: 12345
          disable_notification: true
          disable_web_page_preview: true
          message_thread_id: 7
          parse_mode: HTML
          text: "<b>Mercurio Title</b>\r\"
      headers:
        Content-Type: application/json
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendMessage"
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - name: disable_notification
            value: "true"
          - name: message_thread_id
            value: "7"
          - name: media
            value: "[{\"media\":\"attach://file0\",\"type\":\"photo\"},{\"media\":\"attach://file1\",\"type\":\"photo\"}]"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: file0
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: b.png
            name: file1
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendMediaGroup"
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - name: message_thread_id
            value: "7"
          - b64: iVBORw0KGgo=
            filename: a.png
            name: photo
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendPhoto"
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - name: message_thread_id
            value: "7"
          - b64: iVBORw0KGgo=
            filename: a.png
            name: document
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendDocument"
    - body:
        multipart:
          - name: chat_id
            value: "12345"
          - name: message_thread_id
            value: "7"
          - b64: iVBORw0KGgo=
            filename: b.png
            name: photo
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.telegram.org/bot123456789:abcdefg_hijklmnop/sendPhoto"
  valid: true

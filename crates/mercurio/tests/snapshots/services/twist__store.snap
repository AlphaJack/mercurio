expired_session_relogin:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body:
            form:
              - - email
                - user@example.com
              - - password
                - password
          headers:
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: POST
          url: "https://api.twist.com/api/v3/users/login"
        - body:
            form:
              - - channel_id
                - "12345"
              - - title
                - Mercurio Title
              - - content
                - Mercurio Body
          headers:
            Authorization: Bearer old
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: POST
          url: "https://api.twist.com/api/v3/threads/add"

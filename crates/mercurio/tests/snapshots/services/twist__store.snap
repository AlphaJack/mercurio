missing_channel_dropped:
  sends:
    - attempts: 1
      errors:
        - "channel lookup: service error: no Twist channels to notify"
      ok: false
      requests:
        - body:
            form:
              - - email
                - user@example.com
              - - password
                - password
          headers:
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: POST
          url: "https://api.twist.com/api/v3/users/login"
        - body:
            form:
              - - workspace_id
                - "5"
          headers:
            Authorization: Bearer tok123
            Content-Type: application/x-www-form-urlencoded; charset=utf-8
          method: POST
          url: "https://api.twist.com/api/v3/channels/get"
    - attempts: 1
      errors:
        - "channel lookup: service error: no Twist channels to notify"
      ok: false
      requests: []
  url_id: 63efcd18
  valid: true

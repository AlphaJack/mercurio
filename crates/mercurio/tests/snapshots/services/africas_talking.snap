---
source: crates/mercurio/tests/it/services.rs
---
bad_key:
  error: "Africas Talking: the Africas Talking apikey specified is invalid"
  valid: false
batch:
  ok: true
  requests:
    - body:
        form:
          - - username
            - user
          - - to
            - "+44444444444,55555555555"
          - - from
            - AFRICASTKNG
          - - message
            - "Mercurio Title\r\nMercurio Body"
      headers:
        Accept: application/json
        Content-Type: application/x-www-form-urlencoded
        apiKey: apikey
      method: POST
      url: "https://api.africastalking.com/version1/messaging"
  valid: true

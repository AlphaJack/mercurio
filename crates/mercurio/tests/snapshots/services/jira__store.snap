new_note_close:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              description: full
              details:
                type: failure
              message: disk
              priority: P3
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              note: still full
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts/req-1/notes?identifierType=id"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              note: fixed

          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts/req-1/close?identifierType=id"
  url_id: 5865355b
  valid: true

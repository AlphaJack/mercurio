batch_retry_skips_delivered:
  sends:
    - attempts: 2
      ok: true
      requests:
        - body:
            json:
              description: a
              details:
                type: failure
              message: t
              priority: P3
              responders:
                - type: user
                  username: user1
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts"
        - body:
            json:
              description: a
              details:
                type: failure
              message: t
              priority: P3
              responders:
                - type: user
                  username: user2
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts"
        - body:
            json:
              description: a
              details:
                type: failure
              message: t
              priority: P3
              responders:
                - type: user
                  username: user2
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              note: b
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts/r1/close?identifierType=id"
        - body:
            json:
              note: b
              source: Mercurio Notifications
          headers:
            Accepts: application/json
            Authorization: GenieKey apikey
            Content-Type: application/json
          method: POST
          url: "https://api.atlassian.com/jsm/ops/integration/v2/alerts/r2/close?identifierType=id"
  url_id: 5865355b
  valid: true

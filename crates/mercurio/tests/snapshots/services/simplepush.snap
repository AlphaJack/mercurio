basic:
  ok: true
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          title: Mercurio Title
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
broadcast_needs_spi:
  error: "Simplepush: Simplepush members and broadcast require an organization integration token"
  valid: false
conn_error:
  errors:
    - "transport error: scripted connection error"
  ok: false
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          title: Mercurio Title
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
critical:
  ok: true
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          criticalVolume: 0.5
          priority: 5
          title: Mercurio Title
          topic: alerts
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
empty:
  error: "Simplepush: an invalid Simplepush API Token was specified"
  valid: false
empty_member:
  error: "Simplepush: an invalid Simplepush member was specified"
  valid: false
http_400:
  errors:
    - "HTTP 400: {\"msg\":\"bad\"}"
  ok: false
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          title: Mercurio Title
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
member_needs_spi:
  error: "Simplepush: Simplepush members and broadcast require an organization integration token"
  valid: false
org_bad_wrap:
  errors:
    - "service error: could not open the Simplepush organization keys with this integration token"
  ok: false
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer spi_cred
      method: GET
      url: "https://api.simplepu.sh/v1/org/integration/keys"
  valid: true
org_broadcast:
  ok: true
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer spi_cred
      method: GET
      url: "https://api.simplepu.sh/v1/org/integration/keys"
    - body:
        json:
          broadcast: true
          content: Mercurio Body
          title: Mercurio Title
      headers:
        Authorization: Bearer spi_cred
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
org_broadcast_and_topic:
  error: "Simplepush: a Simplepush broadcast can not be combined with topics or members"
  valid: false
org_enabled_no_keys:
  errors:
    - "service error: the Simplepush organization holds no keys for this integration token"
  ok: false
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer spi_cred
      method: GET
      url: "https://api.simplepu.sh/v1/org/integration/keys"
  valid: true
org_encrypted:
  ok: true
  requests:
    - body: ~
      headers:
        Accept: application/json
        Authorization: Bearer spi_cred
      method: GET
      url: "https://api.simplepu.sh/v1/org/integration/keys"
    - body:
        json:
          content: ~
          contentFormat: markdown
          encryption:
            type: org
            v: 1
          title: ~
          topic: site
      headers:
        Authorization: Bearer spi_cred
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
    - body:
        json:
          content: ~
          contentFormat: markdown
          encryption:
            type: org
            v: 1
          member: Alice
          title: ~
      headers:
        Authorization: Bearer spi_cred
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
org_keys_fail_twice:
  errors:

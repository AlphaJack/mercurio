---
source: crates/mercurio/tests/it/services.rs
---
alias_topic:
  ok: true
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          title: Mercurio Title
          topic: alerts
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
attach:
  ok: true
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          files:
            - checksumSha256: ARHbw5i5TqzaZ1mAnAUFMIaO5+MTszgcL5XOi1UzHFA=
              contentType: image/jpeg
              filename: photo.jpg
              size: 10
          title: Mercurio Title
          topic: alerts
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/upload-url"
    - body:
        text: jpeg-bytes
      headers:
        Content-Type: application/octet-stream
      method: PUT
      url: "https://s3.example/put"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/complete"
  valid: true
attach_complete_fails:
  errors:
    - "service error: Simplepush attachment could not be completed"
  ok: false
  requests:
    - body:
        json:
          content: Mercurio Body
          contentFormat: markdown
          files:
            - checksumSha256: ARHbw5i5TqzaZ1mAnAUFMIaO5+MTszgcL5XOi1UzHFA=
              contentType: image/jpeg
              filename: photo.jpg
              size: 10
          title: Mercurio Title
          topic: alerts
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/upload-url"
    - body:
        text: jpeg-bytes
      headers:
        Content-Type: application/octet-stream
      method: PUT
      url: "https://s3.example/put"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/complete"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/failed"
  valid: true
attach_encrypted:
  ok: true
  requests:
    - body:
        json:
          content: ~
          contentFormat: markdown
          encryption:
            keyFingerprint: CQaZgA2pRm0=
            type: personal
          files:
            - checksumSha256: ~
              contentType: image/jpeg
              filename: photo.jpg
              size: 50
          title: ~
          topic: alerts
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/upload-url"
    - body:
        bytes: "<ignored>"
      headers:
        Content-Type: application/octet-stream
      method: PUT
      url: "https://s3.example/put"
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
      method: POST
      url: "https://api.simplepu.sh/v1/attachments/att_1/complete"
  valid: true
attach_names_as_content:
  ok: true
  requests:
    - body:
        json:
          content: photo.jpg
          files:
            - checksumSha256: ARHbw5i5TqzaZ1mAnAUFMIaO5+MTszgcL5XOi1UzHFA=

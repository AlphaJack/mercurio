        Accept: application/json
        Authorization: Bearer spi_cred
      method: GET
      url: "https://api.simplepu.sh/v1/org/integration/keys"
  valid: true
org_nothing:
  error: "Simplepush: a Simplepush organization send requires a topic, a member or broadcast"
  valid: false
org_password:
  error: "Simplepush: Simplepush organization sends can not be encrypted with a password"
  valid: false
password_no_salt:
  errors:
    - "service error: Simplepush returned no password salt"
  ok: false
  requests:
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
        Accept: application/json
      method: GET
      url: "https://api.simplepu.sh/v1/user"
  valid: true
password_personal:
  ok: true
  requests:
    - body: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
        Accept: application/json
      method: GET
      url: "https://api.simplepu.sh/v1/user"
    - body:
        json:
          content: ~
          contentFormat: markdown
          encryption:
            keyFingerprint: sXUa6akNF9c=
            type: personal
          title: ~
      headers:
        API-Token: AAAAAAAAAAAAAA
        Content-Type: application/json
      method: POST
      url: "https://api.simplepu.sh/v1/tasks/json"
  valid: true
password_query:
  errors:
    - "invalid message: no message body or attachment was specified"
  ok: false
  requests: []
  valid: true
password_salt_fail:

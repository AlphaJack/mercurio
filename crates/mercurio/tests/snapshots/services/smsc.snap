---
source: crates/mercurio/tests/it/services.rs
---
api_error:
  errors:
    - "service error: SMSC error 2: \"invalid login\""
  ok: false
  requests:
    - body:
        form:
          - - login
            - login
          - - psw
            - password
          - - phones
            - "71234567890"
          - - fmt
            - "3"
          - - mes
            - "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://smsc.ru/sys/send.php"
  valid: true

mms:
  ok: true
  requests:
    - body:
        multipart:
          - name: login
            value: login
          - name: psw
            value: pass
          - name: phones
            value: "71234567890"
          - name: fmt
            value: "3"
          - name: sender
            value: Biz
          - name: translit
            value: "1"
          - name: mes
            value: "Mercurio Title\r\nMercurio Body"
          - name: mms
            value: "1"
          - b64: iVBORw0KGgo=
            content_type: image/png
            filename: a.png
            name: mes0
          - b64: aGVsbG8=
            content_type: text/plain
            filename: b.txt
            name: mes1
      headers:
        Content-Type: multipart/form-data
      method: POST
      url: "https://smsc.ru/sys/send.php"
  valid: true

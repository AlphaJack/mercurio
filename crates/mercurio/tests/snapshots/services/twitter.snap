---
source: crates/mercurio/tests/it/services.rs
---
batch_empty_disables:
  ok: true
  requests:
    - body:
        multipart:
          - name: media_category
            value: tweet_image
          - b64: iVBORw0KGgo=
            filename: a.png
            name: media
      headers:
        Authorization: "<ignored>"
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.x.com/2/media/upload"
    - body:
        multipart:
          - name: media_category
            value: tweet_image
          - b64: /9j/4AAQ
            filename: b.jpg
            name: media
      headers:
        Authorization: "<ignored>"
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.x.com/2/media/upload"
    - body:
        json:
          media:
            media_ids:
              - "710511363345354753"
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/tweets"
    - body:
        json:
          media:
            media_ids:
              - "710511363345354753"
          text: 02/02
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/tweets"
  valid: true
blank:
  error: "Twitter: an invalid Twitter Consumer Key was specified"
  valid: false
connection_error:
  errors:
    - "transport error: scripted connection error"
  ok: false
  requests:
    - body:
        json:
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/tweets"
  valid: true
dm_attachments:
  ok: true
  requests:
    - body:
        multipart:
          - name: media_category
            value: dm_image
          - b64: iVBORw0KGgo=
            filename: a.png
            name: media
      headers:
        Authorization: "<ignored>"
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.x.com/2/media/upload"
    - body:
        multipart:
          - name: media_category
            value: dm_image
          - b64: R0lGODlhAQABAAAAACw=
            filename: c.gif
            name: media
      headers:
        Authorization: "<ignored>"
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.x.com/2/media/upload"
    - body: ~
      headers:
        Authorization: "<ignored>"
      method: GET
      url: "https://api.twitter.com/2/users/by?usernames=usera"
    - body:
        json:
          attachments:
            - media_id: "710511363345354753"
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/dm_conversations/with/111/messages"
    - body:
        json:
          attachments:
            - media_id: "710511363345354753"
          text: "Mercurio Title\r\nMercurio Body"
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/dm_conversations/with/222/messages"
    - body:
        json:
          attachments:
            - media_id: "99"
          text: 02/02
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/dm_conversations/with/111/messages"
    - body:
        json:
          attachments:
            - media_id: "99"
          text: 02/02
      headers:
        Authorization: "<ignored>"
        Content-Type: application/json
      method: POST
      url: "https://api.twitter.com/2/dm_conversations/with/222/messages"
  valid: true
dm_lookup_error:
  errors:

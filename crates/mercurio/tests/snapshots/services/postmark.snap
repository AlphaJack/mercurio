---
source: crates/mercurio/tests/it/services.rs
---
accepted_is_failure:
  errors:
    - "HTTP 202: {}"
  ok: false
  requests:
    - body:
        json:
          From: user@example.ca
          HtmlBody: Mercurio Body
          Subject: Mercurio Title
          To: newuser@example.ca
      headers:
        Accept: application/json
        Content-Type: application/json
        X-Postmark-Server-Token: abcd
      method: POST
      url: "https://api.postmarkapp.com/email"
  valid: true
apikey_param:
  ok: true
  requests:
    - body:
        json:
          From: sender@example.com
          HtmlBody: Mercurio Body
          Subject: Mercurio Title
          To: target@example.com
      headers:
        Accept: application/json
        Content-Type: application/json
        X-Postmark-Server-Token: overridekey
      method: POST
      url: "https://api.postmarkapp.com/email"
  valid: true
attachment:
  ok: true
  requests:
    - body:
        json:
          Attachments:
            - Content: iVBORw0KGgo=
              ContentType: image/png
              Name: a.png
            - Content: aGVsbG8=
              ContentType: text/plain
              Name: b.txt
          From: user@example.com
          HtmlBody: Mercurio Body
          Subject: Mercurio Title
          To: a@example.com
      headers:
        Accept: application/json
        Content-Type: application/json
        X-Postmark-Server-Token: abcd
      method: POST
      url: "https://api.postmarkapp.com/email"
  valid: true
bad_target:
  errors:
    - "service error: there are no Postmark email recipients to notify"
  ok: false
  requests: []
  valid: true

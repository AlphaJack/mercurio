---
source: crates/mercurio/tests/it/services.rs
---
basic:
  ok: true
  requests:
    - body:
        json:
          messages:
            - sender:
                iconUrl: "https://example.org/info-128x128.png"
                name: Mercurio
              text: "Mercurio Title\r\nMercurio Body"
              type: text
          to: target
      headers:
        Authorization: Bearer token=
        Content-Type: application/json
      method: POST
      url: "https://api.line.me/v2/bot/message/push"
  valid: true

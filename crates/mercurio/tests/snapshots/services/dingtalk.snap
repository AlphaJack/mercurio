all_params:
  ok: true
  requests:
    - body:
        json:
          at:
            atMobiles:
              - "11111111111111"
            isAtAll: false
          msgtype: text
          text:
            content: "Mercurio Title\r\nMercurio Body"
      headers:
        Content-Type: application/json
      method: POST

pipeline_html:
  ok: true
  requests:
    - body:
        json:
          from:
            email: user@example.com
          html: "<h1>Release</h1><p>Hello <b>bold</b> &amp; <i>it</i> <u>u</u> <a href=\"http://example.com\">link</a></p><ul><li>one</li><li>two</li></ul><pre>x  y\nz</pre><script>no()</script><br/>end"
          subject: Mercurio Title
          text: "Release\n\nHello bold & it u link\n\n- one\n- two\n\nx  y\nz\n\nend"
          to:
            - email: user@example.com
      headers:
        Accept: application/json
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.mailersend.com/v1/email"
  valid: true
pipeline_markdown:
  ok: true
  requests:
    - body:
        json:
          from:
            email: user@example.com
          html: "<h1>Release notes</h1>\n<p>This has <strong>bold</strong>, <em>italic</em>, <code>code</code> and a <a href=\"http://example.com/a_b\">link</a>.</p>\n<ul>\n<li>first item</li>\n<li>second <em>item</em></li>\n</ul>\n<blockquote>\n<p>quoted * text &amp; more <stuff></p>\n</blockquote>\n<p><del>gone</del> :smile:</p>"
          subject: Mercurio Title
          text: "Release notes\n\nThis has bold, italic, code and a link.\n\n- first item\n- second item\n\nquoted * text & more\n\ngone :smile:"
          to:
            - email: user@example.com
      headers:
        Accept: application/json
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.mailersend.com/v1/email"
  valid: true

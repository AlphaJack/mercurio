---
source: crates/mercurio/tests/it/services.rs
---
attachment:
  ok: true
  requests:
    - body:
        json:
          attachments:
            - content: iVBORw0KGgo=
              disposition: attachment
              filename: a.png
            - content: aGVsbG8=
              disposition: attachment
              filename: b.txt
          from:
            email: user@example.com
          html: Mercurio Body
          subject: Mercurio Title
          text: Mercurio Body
          to:
            - email: to@example.com
      headers:
        Accept: application/json
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.mailersend.com/v1/email"
  valid: true
bad_target:
  errors:
    - "service error: there are no MailerSend email recipients to notify"
  ok: false
  requests: []
  valid: true
bcc:
  ok: true
  requests:
    - body:
        json:
          bcc:
            - email: bcc@example.com
          from:
            email: user@example.com
          html: Mercurio Body
          subject: Mercurio Title
          text: Mercurio Body
          to:
            - email: user@example.com
      headers:
        Accept: application/json
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.mailersend.com/v1/email"
  valid: true
cc:

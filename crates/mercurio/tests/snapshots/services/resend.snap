accepted:
  ok: true
  requests:
    - body:
        json:
          from: user@example.ca
          html: Mercurio Body
          subject: Mercurio Title
          to: newuser0@example.ca
      headers:
        Authorization: Bearer abcd
        Content-Type: application/json
      method: POST
      url: "https://api.resend.com/emails"
  valid: true

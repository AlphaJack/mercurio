pipeline_markdown:
  ok: true
  requests:
    - body:
        json:
          message: "# Release notes\n\nThis has **bold**, *italic*, `code` and a [link](http://example.com/a_b).\n\n- first item\n- second *item*\n\n> quoted \\* text & more <stuff>\n\n~~gone~~ :smile:"
          title: Mercurio Title
          topic: topic
      headers:
        Authorization: Basic dXNlcjo=
        Content-Type: application/json
        X-Icon: "https://example.org/info-256x256.png"
      method: POST
      url: "http://localhost"
  valid: true

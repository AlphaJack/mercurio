      method: POST
      url: "https://login.microsoftonline.com/tenant/oauth2/v2.0/token"
    - body:
        json:
          message:
            bccRecipients:
              - emailAddress:
                  address: bcc@test.ca
            body:
              content: Mercurio Body
              contentType: HTML
            ccRecipients:
              - emailAddress:
                  address: cc@test.ca
                  name: Chris
            from:
              emailAddress:
                address: user@example.edu
                name: Sender Name
            subject: Mercurio Title
            toRecipients:
              - emailAddress:
                  address: bob@test.ca
                  name: Bob
          saveToSentItems: "true"
      headers:
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://graph.microsoft.com/v1.0/users/Sender Name<user@example.edu>/sendMail"
  valid: true

---
source: crates/mercurio/tests/it/services.rs
---
attachment_small:
  ok: true
  requests:
    - body:
        form:
          - - grant_type
            - client_credentials
          - - client_id
            - ab-cd-ef-gh
          - - client_secret
            - secret
          - - scope
            - "https://graph.microsoft.com/.default"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://login.microsoftonline.com/tenant/oauth2/v2.0/token"
    - body:
        json:
          message:
            attachments:
              - "@odata.type": "#microsoft.graph.fileAttachment"
                contentBytes: iVBORw0KGgo=
                contentType: image/png
                name: a.png
            body:
              content: Mercurio Body
              contentType: HTML
            from:
              emailAddress:
                address: user@example.edu
                name: Mercurio
            subject: Mercurio Title
            toRecipients:
              - emailAddress:
                  address: email1@test.ca
          saveToSentItems: "true"
      headers:
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "https://graph.microsoft.com/v1.0/users/user@example.edu/sendMail"
  valid: true
auth_no_token:
  errors:
    - "token: service error: Office 365 authentication failed"
  ok: false
  requests:
    - body:
        form:
          - - grant_type
            - client_credentials
          - - client_id
            - ab-cd-ef-gh
          - - client_secret
            - secret
          - - scope
            - "https://graph.microsoft.com/.default"
      headers:
        Content-Type: application/x-www-form-urlencoded
      method: POST
      url: "https://login.microsoftonline.com/tenant/oauth2/v2.0/token"
  valid: true

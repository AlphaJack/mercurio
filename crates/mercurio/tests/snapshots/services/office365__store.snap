---
source: crates/mercurio/tests/it/services.rs
---
auth_fails_then_works:
  sends:
    - attempts: 1
      errors:
        - "token: service error: Office 365 authentication failed"
      ok: false
      requests:
        - body:
            form:
              - - grant_type
                - client_credentials
              - - client_id
                - ab-cd-ef-gh
              - - client_secret
                - secret
              - - scope
                - "https://graph.microsoft.com/.default"
          headers:
            Content-Type: application/x-www-form-urlencoded
          method: POST
          url: "https://login.microsoftonline.com/tenant/oauth2/v2.0/token"
    - attempts: 1
      ok: true
      requests:
        - body:
            form:
              - - grant_type
                - client_credentials
              - - client_id
                - ab-cd-ef-gh
              - - client_secret
                - secret
              - - scope
                - "https://graph.microsoft.com/.default"
          headers:
            Content-Type: application/x-www-form-urlencoded
          method: POST
          url: "https://login.microsoftonline.com/tenant/oauth2/v2.0/token"
        - body:
            json:
              message:
                body:
                  content: Mercurio Body
                  contentType: HTML
                from:
                  emailAddress:
                    address: user@example.edu
                    name: Mercurio
                subject: Mercurio Title
                toRecipients:
                  - emailAddress:
                      address: email1@test.ca
              saveToSentItems: "true"
          headers:
            Authorization: Bearer abcd1234
            Content-Type: application/json
          method: POST
          url: "https://graph.microsoft.com/v1.0/users/user@example.edu/sendMail"
  url_id: 57cb78ed
  valid: true
personal_refresh_token_rotated:
  sends:
    - attempts: 1
      ok: true
      requests:
        - body:
            form:
              - - grant_type
                - refresh_token
              - - client_id
                - ab-cd-ef-gh
              - - refresh_token
                - refresh-secret
              - - scope
                - "https://graph.microsoft.com/Mail.Send offline_access"
          headers:
            Content-Type: application/x-www-form-urlencoded
          method: POST
          url: "https://login.microsoftonline.com/consumers/oauth2/v2.0/token"
        - body:
            json:
              message:
                body:
                  content: Mercurio Body
                  contentType: HTML
                from:
                  emailAddress:
                    address: user@outlook.com
                    name: Mercurio
                subject: Mercurio Title
                toRecipients:
                  - emailAddress:
                      address: to@example.com
              saveToSentItems: "true"
          headers:
            Authorization: Bearer t1
            Content-Type: application/json
          method: POST
          url: "https://graph.microsoft.com/v1.0/me/sendMail"
    - attempts: 1
      ok: true
      requests:
        - body:
            form:
              - - grant_type
                - refresh_token
              - - client_id
                - ab-cd-ef-gh
              - - refresh_token
                - rotated1
              - - scope
                - "https://graph.microsoft.com/Mail.Send offline_access"
          headers:
            Content-Type: application/x-www-form-urlencoded
          method: POST
          url: "https://login.microsoftonline.com/consumers/oauth2/v2.0/token"
        - body:
            json:
              message:
                body:
                  content: Mercurio Body
                  contentType: HTML
                from:
                  emailAddress:
                    address: user@outlook.com
                    name: Mercurio
                subject: Mercurio Title
                toRecipients:
                  - emailAddress:
                      address: to@example.com
              saveToSentItems: "true"
          headers:
            Authorization: Bearer t2
            Content-Type: application/json
          method: POST
          url: "https://graph.microsoft.com/v1.0/me/sendMail"
  url_id: 98ed644b
  valid: true

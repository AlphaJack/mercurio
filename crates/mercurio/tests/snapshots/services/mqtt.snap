---
source: crates/mercurio/tests/it/services.rs
---
basic:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 0
        retain: false
        topic: my/topic
  ok: true
  valid: true
client_id_only:
  events:
    - client:
        clean_session: true
        client_id: my client
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 0
        retain: false
        topic: my/topic
  ok: true
  valid: true
connack_refused:
  errors:
    - "service error: MQTT broker refused the connection: not authorised (code 5)"
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - username_pw_set:
        password: bad
        username: user
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
  ok: false
  valid: true
connect_refused:
  errors:
    - "transport error: no scripted connection for localhost:1883"
  events: []
  ok: false
  valid: true
empty_password:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - username_pw_set:
        password: ""
        username: user
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 0
        retain: false
        topic: t
  ok: true
  valid: true
no_host:
  error: "MQTT Notification: an invalid hostname or port was specified"
  valid: false
no_puback:
  errors:
    - "transport error: connection closed"
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 1
        retain: false
        topic: t
  ok: false
  valid: true
no_pubrec:
  errors:
    - "transport error: connection closed"
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 2
        retain: false
        topic: t
  ok: false
  valid: true
no_title:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: only body
        qos: 0
        retain: false
        topic: t
  ok: true
  valid: true
no_topic:
  errors:
    - "invalid message: there were no MQTT topics to notify"
  events: []
  ok: false
  valid: true
port:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - connect:
        host: localhost
        keepalive: 30
        port: 1234
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 0
        retain: false
        topic: my/topic
  ok: true
  valid: true
qos2_auth:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - username_pw_set:
        password: pass
        username: user
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 2
        retain: false
        topic: a/b
  ok: true
  valid: true
qos_invalid:
  error: "MQTT Notification: An invalid MQTT QOS (invalid) was specified."
  valid: false
qos_negative:
  error: "MQTT Notification: An invalid MQTT QOS (-1) was specified."
  valid: false
qos_too_big:
  error: "MQTT Notification: An invalid MQTT QOS (123) was specified."
  valid: false
qos_v31:
  events:
    - client:
        clean_session: true
        client_id: "<random-client-id>"
        protocol: 3
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 1
        retain: false
        topic: my/topic
  ok: true
  valid: true
retain:
  events:
    - client:
        clean_session: true
        client_id: ""
        protocol: 4
    - username_pw_set:
        password: ~
        username: user
    - connect:
        host: localhost
        keepalive: 30
        port: 1883
    - publish:
        payload: "Mercurio Title\r\nMercurio Body"
        qos: 0
        retain: true
        topic: my/topic
  ok: true
  valid: true

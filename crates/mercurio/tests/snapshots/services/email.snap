html_body:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - charset: utf-8
              text: "Hello World & friends\n\nNext line\n\n- one\n- two"
              type: text/plain
            - charset: utf-8
              text: "<p>Hello <b>World</b> &amp; friends</p><br/>Next line<ul><li>one</li><li>two</li></ul><script>var x = '<b>';</script>"
              type: text/html
          type: multipart/alternative
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true
inline_html:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - parts:
                - charset: utf-8
                  text: Mercurio Body
                  type: text/plain
                - charset: utf-8
                  text: "Mercurio Body<br/><img src=\"cid:my%20image.png\">"
                  type: text/html
              type: multipart/alternative
            - b64: iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==
              content_id: "<my%20image.png>"
              disposition: inline
              filename: my image.png
              type: image/png
            - b64: JVBERi0xLjQK
              disposition: attachment
              filename: doc.pdf
              type: application/pdf
          type: multipart/related
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com

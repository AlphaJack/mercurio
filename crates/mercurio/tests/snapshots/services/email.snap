---
source: crates/mercurio/tests/it/services.rs
---
attach_png_html:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - parts:
                - charset: utf-8
                  text: Mercurio Body
                  type: text/plain
                - charset: utf-8
                  text: Mercurio Body
                  type: text/html
              type: multipart/alternative
            - b64: iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==
              disposition: attachment
              filename: a.png
              type: image/png
          type: multipart/mixed
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true
attach_text:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - charset: utf-8
              text: Mercurio Body
              type: text/plain
            - b64: aGVsbG8gZmlsZQ==
              disposition: attachment
              filename: notes.txt
              type: text/plain
          type: multipart/mixed
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true
attach_two:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - parts:
                - charset: utf-8
                  text: Mercurio Body
                  type: text/plain
                - charset: utf-8
                  text: Mercurio Body
                  type: text/html
              type: multipart/alternative
            - b64: iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==
              disposition: attachment
              filename: a.png
              type: image/png
            - b64: eyJrIjogMX0=
              disposition: attachment
              filename: data.json
              type: application/json
          type: multipart/mixed
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true

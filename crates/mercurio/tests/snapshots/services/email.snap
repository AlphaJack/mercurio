dot_stuffing:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          charset: utf-8
          text: "first\n.\n..second\n.third"
          type: text/plain
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - Mercurio Title
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true
empty:
  error: "E-Mail: an invalid ~From~ email was specified"
  valid: false
empty_secure:
  error: "E-Mail: an invalid ~From~ email was specified"
  valid: false
empty_title:
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      message:
        body:
          parts:
            - charset: utf-8
              text: just a body
              type: text/plain
            - charset: utf-8
              text: just a body
              type: text/html
          type: multipart/alternative
        headers:
          - - from
            - Mercurio <user@example.com>
          - - subject
            - ""
          - - to
            - user@example.com
          - - x-application
            - Mercurio
      smtp: sendmail
      to:
        - user@example.com
    - smtp: quit
  ok: true
  valid: true
empty_user_dot_pass:
  error: "E-Mail: an invalid ~From~ email was specified"
  valid: false
fail_connect:
  errors:
    - "transport error: no scripted connection for example.com:587"
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
  ok: false
  valid: true
fail_login:
  errors:
    - "service error: SMTP authentication failed: 535 bad credentials"
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - smtp: quit
  ok: false
  valid: true
fail_refused:
  errors:
    - "service error: 2 of 2 messages failed; first: service error: SMTP server refused all 1 recipient(s)"
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - from: user@example.com
      refused: true
      smtp: sendmail
      to:
        - a@example.com
    - from: user@example.com
      refused: true
      smtp: sendmail
      to:
        - b@example.com
    - smtp: quit
  ok: false
  valid: true
fail_sender:
  errors:
    - "service error: SMTP MAIL FROM failed: 550 sender refused"
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - password: pass
      smtp: login
      user: user
    - failed: true
      from: user@example.com
      smtp: sendmail
    - smtp: quit
  ok: false
  valid: true
fail_ssl_login:
  errors:
    - "service error: SMTP authentication failed: 535 bad credentials"
  events:
    - host: nuxref.com
      port: 465
      smtp: connect
      ssl: true
    - password: pass
      smtp: login
      user: user
    - smtp: quit
  ok: false
  valid: true
fail_starttls:
  errors:
    - "service error: SMTP STARTTLS failed: 454 TLS not available"
  events:
    - host: example.com
      port: 587
      smtp: connect
      ssl: false
    - smtp: starttls
    - smtp: quit
  ok: false
  valid: true

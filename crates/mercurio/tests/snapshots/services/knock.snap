actor_tenant_cancel_data:
  ok: true
  requests:
    - body:
        json:
          actor: mr_dna
          cancellation_key: incident_1993
          data:
            body: Mercurio Body
            severity: high
            title: Mercurio Title
            type: info
          recipients:
            - dr_grant
          tenant: ingen
      headers:
        Accept: application/json
        Authorization: Bearer sk_test_123
        Content-Type: application/json
      method: POST
      url: "https://api.knock.app/v1/workflows/new-comment/trigger"
  valid: true

  requests:
    - body:
        json:
          message_globals:
            channel: sms
          messages:
            - content: "Mercurio Title\r\nMercurio Body"
              data_coding: auto
              recipients:
                - "33333333333333"
      headers:
        Accept: application/json
        Authorization: Bearer token1
        Content-Type: application/json

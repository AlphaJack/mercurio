login_fails_then_works:
  sends:
    - attempts: 1
      errors:
        - "login: HTTP 500: {}"
      ok: false
      requests:
        - body:
            json:
              Username: l2g
              password: ""
              passwordMd5: ""
              pw: ""
          headers:
            Content-Type: application/json
            X-Emby-Authorization: "MediaBrowser Client=\"Mercurio\", Device=\"Mercurio\", DeviceId=\"62f9c32a-4bdb-57d9-8f5e-26782f8d9e28\", Version=\"<version>\""
          method: POST
          url: "https://localhost:1234/Users/AuthenticateByName"
    - attempts: 1
      ok: true
      requests:
        - body:
            json:
              Username: l2g
              password: ""
              passwordMd5: ""
              pw: ""
          headers:
            Content-Type: application/json
            X-Emby-Authorization: "MediaBrowser Client=\"Mercurio\", Device=\"Mercurio\", DeviceId=\"62f9c32a-4bdb-57d9-8f5e-26782f8d9e28\", Version=\"<version>\""
          method: POST
          url: "https://localhost:1234/Users/AuthenticateByName"
        - body: ~
          headers:
            Content-Type: application/json
            X-Emby-Authorization: "MediaBrowser Client=\"Mercurio\", Device=\"Mercurio\", DeviceId=\"62f9c32a-4bdb-57d9-8f5e-26782f8d9e28\", Version=\"<version>\", UserId=\"l2g\""
            X-MediaBrowser-Token: tok
          method: GET
          url: "https://localhost:1234/Sessions?ControllableByUserId=u2"
        - body:
            json:
              Header: Mercurio Title
              Text: Mercurio Body
              TimeoutMs: 60000
          headers:
            Content-Type: application/json
            X-Emby-Authorization: "MediaBrowser Client=\"Mercurio\", Device=\"Mercurio\", DeviceId=\"62f9c32a-4bdb-57d9-8f5e-26782f8d9e28\", Version=\"<version>\", UserId=\"l2g\""
            X-MediaBrowser-Token: tok
          method: POST
          url: "https://localhost:1234/Sessions/s1/Message"

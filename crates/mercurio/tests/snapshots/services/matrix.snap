rate_limited_bad_wait:
  errors:
    - "room join: service error: could not join the room"
  ok: false
  requests:
    - body:
        json:
          identifier:
            type: m.id.user
            user: user
          initial_device_display_name: Mercurio
          password: pass
          type: m.login.password
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/login"
    - body:
        json:
          auth:
            type: m.login.dummy
          initial_device_display_name: Mercurio
          kind: user
          password: pass
          username: user
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/register?kind=user"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/join/%21room%3Alocalhost"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/logout"
  valid: true

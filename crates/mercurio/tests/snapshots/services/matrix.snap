---
source: crates/mercurio/tests/it/services.rs
---
accepted_202:
  ok: true
  requests:
    - body:
        json:
          identifier:
            type: m.id.user
            user: user
          initial_device_display_name: Mercurio
          password: pass
          type: m.login.password
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/login"
    - body:
        json:
          auth:
            type: m.login.dummy
          initial_device_display_name: Mercurio
          kind: user
          password: pass
          username: user
      headers:
        Accept: application/json
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/register?kind=user"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/join/%21room%3Alocalhost"
    - body:
        json:
          body: "# Mercurio Title\r\nMercurio Body"
          msgtype: m.text
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "http://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/send/m.room.message/0"
    - body:
        json: {}
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: POST
      url: "http://localhost/_matrix/client/v3/logout"
  valid: true

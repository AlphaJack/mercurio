        json:
          body: a.png
          info:
            mimetype: image/png
            size: 70
          msgtype: m.image
          room_id: "!room:localhost"
          type: m.room.message
          url: "mxc://x/y"
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json

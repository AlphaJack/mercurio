          filename: notes.txt
          info:
            mimetype: text/plain
            size: 5
          msgtype: m.file
          room_id: "!room:localhost"
          type: m.room.message
          url: "mxc://localhost/txt"
      headers:
        Accept: application/json
        Authorization: Bearer abcd1234
        Content-Type: application/json
      method: PUT
      url: "http://localhost/_matrix/client/v3/rooms/%21room%3Alocalhost/send/m.room.message/1"

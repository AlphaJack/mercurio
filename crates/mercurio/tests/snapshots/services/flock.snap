  error: "Flock: an invalid Flock Access Key was specified"
  valid: false
botname:
  ok: true
  requests:
    - body:
        json:
          flockml: "<flockml><b>Mercurio Title</b><br/>Mercurio Body</flockml>"
          sendAs:
            name: mybot
            profileImage: "https://example.org/failure-72x72.png"
          token: tttttttttttttttttttttttt
      headers:
        Content-Type: application/json
      method: POST
      url: "https://api.flock.com/hooks/sendMessage/tttttttttttttttttttttttt"
  valid: true

  events:
    - cmd:
        - terminal-notifier
        - "-message"
        - "\\-body"
        - "-title"
        - "\\-title"
        - "-sound"
        - "\\-x"
        - "-sender"
        - "\\Mercurio"
        - "-appIcon"
        - "\\<tmp>/mercurio/logo.png"
  ok: true
  valid: true

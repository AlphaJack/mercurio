---
source: crates/mercurio/tests/it/services.rs
---
basic:
  events:
    - cmd:
        - terminal-notifier
        - "-version"
    - cmd:
        - terminal-notifier
        - "-message"
        - "\\Mercurio Body"
        - "-title"
        - "\\Mercurio Title"
        - "-contentImage"
        - "<image>"
  ok: true
  valid: true
click:
  events:
    - cmd:
        - terminal-notifier
        - "-version"
    - cmd:
        - terminal-notifier
        - "-message"
        - "\\Mercurio Body"
        - "-title"
        - "\\Mercurio Title"
        - "-open"
        - "\\http://google.com"
        - "-contentImage"
        - "<image>"
  ok: true
  valid: true

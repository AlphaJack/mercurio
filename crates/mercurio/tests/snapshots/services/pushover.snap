source: crates/mercurio/tests/it/services.rs
---
attach_e2ee:
  ok: true
  requests:
    - body:
        multipart:
          - name: token
            value: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          - name: priority
            value: "0"
          - name: title
            value: "<ignored>"
          - name: message
            value: "<ignored>"
          - name: sound
            value: pushover
          - name: encrypted
            value: "1"
          - name: user
            value: uuuuuuuuuuuuuuuuuuuuuuuuuuuuuu
          - name: device
            value: ALL_DEVICES
          - b64: iVBORw0KGgo=
            filename: a.png
            name: attachment
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhOg==
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.pushover.net/1/messages.json"
    - body:
        multipart:
          - name: token
            value: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          - name: priority
            value: "0"
          - name: title
            value: "<ignored>"
          - name: message
            value: "<ignored>"
          - name: sound
            value: none
          - name: encrypted
            value: "1"
          - name: user
            value: uuuuuuuuuuuuuuuuuuuuuuuuuuuuuu
          - name: device
            value: ALL_DEVICES
          - b64: R0lGODlhAQABAAAAACw=
            filename: b.gif
            name: attachment
      headers:
        Authorization: Basic YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhOg==
        Content-Type: multipart/form-data
      method: POST
      url: "https://api.pushover.net/1/messages.json"
  valid: true
